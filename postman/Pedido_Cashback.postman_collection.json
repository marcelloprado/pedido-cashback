    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// ===== Collection-level test script =====",
          "// These assertions run after EVERY request in the collection.",
          "// Request-specific logic is gated by request name.",
          "",
          "const requestName = pm.info.requestName;",
          "",
          "// --- UploadAvatar assertions ---",
          "if (requestName === \"UploadAvatar\") {",
          "    pm.test(\"Upload: status is 200\", function () {",
          "        pm.response.to.have.status(200);",
          "    });",
          "",
          "    pm.test(\"Upload: response is JSON\", function () {",
          "        pm.response.to.be.json;",
          "    });",
          "",
          "    pm.test(\"Upload: response contains 'Key' field\", function () {",
          "        const json = pm.response.json();",
          "        pm.expect(json).to.have.property(\"Key\");",
          "        pm.expect(json.Key).to.be.a(\"string\").and.not.empty;",
          "    });",
          "",
          "    pm.test(\"Upload: response contains 'Id' field\", function () {",
          "        const json = pm.response.json();",
          "        pm.expect(json).to.have.property(\"Id\");",
          "    });",
          "",
          "    // Persist the uploaded filename for the DELETE request",
          "    const json = pm.response.json();",
          "    if (json && json.Key) {",
          "        // Key is like \"Avatars/test-avatar-123.jpg\" — extract just the filename part",
          "        const parts = json.Key.split(\"/\");",
          "        const filename = parts[parts.length - 1];",
          "        pm.collectionVariables.set(\"upload_filename\", filename);",
          "        pm.collectionVariables.set(\"uploaded_key\", json.Key);",
          "    }",
          "}",
          "",
          "// --- DeleteAvatar assertions ---",
          "if (requestName === \"DeleteAvatar\") {",
          "    pm.test(\"Delete: status is 200\", function () {",
          "        pm.response.to.have.status(200);",
          "    });",
          "",
          "    pm.test(\"Delete: response is JSON\", function () {",
          "        pm.response.to.be.json;",
          "    });",
          "",
          "    pm.test(\"Delete: response is an array (deleted objects list)\", function () {",
          "        const json = pm.response.json();",
          "        pm.expect(json).to.be.an(\"array\");",
          "    });",
          "",
          "    pm.test(\"Delete: deleted array is not empty\", function () {",
          "        const json = pm.response.json();",
          "        pm.expect(json.length).to.be.greaterThan(0);",
          "    });",
          "",
          "    pm.test(\"Delete: deleted object has 'name' field\", function () {",
          "        const json = pm.response.json();",
          "        pm.expect(json[0]).to.have.property(\"name\");",
          "    });",
          "}"
        ]
      }
    }
