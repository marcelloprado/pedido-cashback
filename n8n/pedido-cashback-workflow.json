    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normaliza os dados vindos do formulário + o cliente (existente ou recém-criado)\nconst webhook = $('Webhook').item.json;\nconst wh = webhook.body ?? webhook;\n\n// id do cliente: se veio do \"Buscar Cliente\" (true) ou do \"Criar Cliente\" (false)\nconst clienteId = $json.id ?? wh.cliente_id ?? null;\n\nconst valorRaw = String(wh.valor ?? wh.amount ?? '0');\nconst valor = Number(valorRaw.replace(/[^0-9.,-]/g, '').replace(/\\.(?=\\d{3}(\\D|$))/g, '').replace(',', '.')) || 0;\n\nreturn {\n  json: {\n    cliente_id: clienteId,\n    nome: (wh.nome ?? '').trim(),\n    email: (wh.email ?? '').trim().toLowerCase(),\n    telefone: String(wh.telefone ?? '').replace(/\\D/g, ''),\n    valor,\n   descricao: `Compra de ${wh.produto}`,\n    criado_em: new Date().toISOString(),\n  },\n};"
      },
